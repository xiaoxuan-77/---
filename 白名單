-- [[ 修改後的 AUTH LOGIC：Key 錯誤直接 Kick ]]
LoginBtn.MouseButton1Click:Connect(function()
    local key = KeyBox.Text
    if key == "" then 
        LoginBtn.Text = "PLEASE ENTER KEY"
        task.wait(2)
        LoginBtn.Text = "ACCESS SYSTEM"
        return 
    end

    LoginBtn.Text = "VERIFYING..."

    -- Step 1: Init
    local init_url = "https://keyauth.win/api/1.1/?name="..HttpService:UrlEncode(Settings.Name).."&ownerid="..Settings.Owner.."&type=init&ver="..Settings.Version
    local success1, res = pcall(function() return game:HttpGet(init_url) end)
    
    if not success1 or not res then
        LoginBtn.Text = "NETWORK ERROR"
        task.wait(2)
        LoginBtn.Text = "ACCESS SYSTEM"
        return
    end

    local data = HttpService:JSONDecode(res)
    
    if not data.success then
        -- Init 失敗也直接踢（防止繞過）
        if setclipboard then setclipboard(hwid) end
        localPlayer:Kick("\n【 YLI SYSTEM | 認證失敗 】\n\n伺服器初始化失敗！\n您的 HWID 已自動複製，請聯繫作者。\n\nHWID: " .. hwid)
        return
    end

    -- Step 2: License Check
    local login_url = "https://keyauth.win/api/1.1/?name="..HttpService:UrlEncode(Settings.Name).."&ownerid="..Settings.Owner.."&type=license&key="..key.."&sessionid="..data.sessionid.."&ver="..Settings.Version
    local success2, l_res = pcall(function() return game:HttpGet(login_url) end)
    
    if not success2 or not l_res then
        if setclipboard then setclipboard(hwid) end
        localPlayer:Kick("\n【 YLI SYSTEM | 認證失敗 】\n\n網路錯誤！\n您的 HWID 已自動複製，請聯繫作者。\n\nHWID: " .. hwid)
        return
    end

    local l_data = HttpService:JSONDecode(l_res)
    
    if l_data.success then
        -- 成功！顯示歡迎後載入核心
        LoginBtn.Text = "WELCOME"
        TweenService:Create(Main, TweenInfo.new(0.5), {Size = UDim2.new(0,0,0,0), BackgroundTransparency = 1}):Play()
        task.wait(0.6)
        ScreenGui:Destroy()
        
        -- 顯示成功通知（可選）
        StarterGui:SetCore("SendNotification", {
            Title = "YLI SYSTEM",
            Text = "認證成功！核心載入中...",
            Duration = 5
        })
        
        loadstring(game:HttpGet(Settings.CoreURL))()
    else
        -- 失敗：複製 HWID 並 Kick
        if setclipboard then setclipboard(hwid) end
        localPlayer:Kick("\n【 厭璃系統 | 認證失敗 】\n\n無效或過期的卡密\n您的 HWID 已自動複製，請聯繫作者購買/登記。\n\nHWID: " .. hwid)
    end
end)
